# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# @defaultRequired=infer @defaultSensitive=false
# @currentEnv=$APP_ENV
# @generateTsTypes(path=env.d.ts)
# ----------

# Controls environment-specific file loading, such as .env.production.
# @type=enum(development, production)
APP_ENV=development

# Canonical URL used by SEO metadata, feeds, and the sitemap.
# @public @type=url @docs(https://docs.astro.build/en/guides/configuring-astro/)
SITE_URL=https://steekam.me

# OpenSubtitles API credential. Set this only in .env.local or a secret provider.
# @sensitive @optional @docs(https://opensubtitles.stoplight.io/docs/opensubtitles-api/e3750fd63a100-getting-started)
OPEN_SUBTITLES_API_KEY=

# Account identifier for POST /login. It is not an authentication secret; keep it local unless needed by a deployment.
# @public @optional
OPEN_SUBTITLES_USERNAME=

# @sensitive @optional
OPEN_SUBTITLES_PASSWORD=

# Optional short-lived JWT returned by POST /login. Prefer username/password for one process.
# @sensitive @optional
OPEN_SUBTITLES_TOKEN=

# OpenSubtitles requires an app name and version in every User-Agent header.
# @public @docs(https://opensubtitles.stoplight.io/docs/opensubtitles-api/e3750fd63a100-getting-started)
OPEN_SUBTITLES_USER_AGENT=The Lasso Away v0.1.0
