# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# @defaultRequired=infer @defaultSensitive=false
# @currentEnv=$APP_ENV
# @generateTsTypes(path=env.d.ts)
# ----------

# Controls environment-specific file loading, such as .env.production.
# @type=enum(development, production)
APP_ENV=development

# Canonical URL used by SEO metadata, feeds, and the sitemap.
# @public @type=url @docs(https://docs.astro.build/en/guides/configuring-astro/)
SITE_URL=https://steekam.me

# OpenSubtitles API credential. Set this only in .env.local or a secret provider.
# @sensitive
OPEN_SUBTITLES_API_KEY=
