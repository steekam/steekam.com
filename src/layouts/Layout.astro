---
import '@/styles/global.css';
import avatar from '@/assets/16-bit-avatar-cutout.png';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { absoluteUrl, jsonLdScript, PERSON, PERSON_ID, SITE_DESCRIPTION, SITE_NAME, WEBSITE_ID } from '@/lib/seo';

type PageKind = 'home' | 'article' | 'topics' | 'topic' | 'projects' | 'notfound';

interface Props {
  title?: string;
  headline?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  pageKind?: PageKind;
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  section?: string;
  wordCount?: number;
  breadcrumb?: Array<{ name: string; url: string }>;
  immersive?: boolean;
}

const {
  title = SITE_NAME,
  headline = title,
  description = SITE_DESCRIPTION,
  image = absoluteUrl('/og/home.png'),
  imageAlt = `${SITE_NAME} field notes`,
  pageKind = 'home',
  publishedTime,
  modifiedTime,
  tags = [],
  section,
  wordCount: articleWordCount,
  breadcrumb = [],
  immersive = false,
} = Astro.props;

const canonicalUrl = absoluteUrl(Astro.url.pathname, true);
const markdownUrl = pageKind === 'article'
  ? absoluteUrl(`${Astro.url.pathname.replace(/\/$/, '')}.md`)
  : undefined;
const person = { ...PERSON, image: absoluteUrl(avatar.src) };

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      ...person,
    },
    {
      '@type': 'WebSite',
      '@id': WEBSITE_ID,
      name: SITE_NAME,
      description: SITE_DESCRIPTION,
      url: absoluteUrl('/'),
      publisher: { '@id': PERSON_ID },
      inLanguage: 'en',
    },
    pageKind === 'article'
      ? {
          '@type': 'BlogPosting',
          '@id': `${canonicalUrl}#article`,
          headline,
          description,
          url: canonicalUrl,
          mainEntityOfPage: canonicalUrl,
          image: {
            '@type': 'ImageObject',
            url: image,
            width: 1200,
            height: 630,
          },
          thumbnailUrl: image,
          datePublished: publishedTime,
          ...(modifiedTime ? { dateModified: modifiedTime } : {}),
          author: { '@id': PERSON_ID },
          publisher: { '@id': PERSON_ID },
          isPartOf: { '@id': WEBSITE_ID },
          inLanguage: 'en',
          ...(section ? { articleSection: section } : {}),
          ...(tags.length ? { keywords: tags } : {}),
          ...(articleWordCount ? { wordCount: articleWordCount } : {}),
        }
      : pageKind === 'home'
        ? {
          '@type': 'ProfilePage',
          '@id': canonicalUrl,
          name: title,
          description,
          url: canonicalUrl,
          mainEntity: { '@id': PERSON_ID },
          isPartOf: { '@id': WEBSITE_ID },
          inLanguage: 'en',
        }
        : {
          '@type': pageKind === 'notfound' ? 'WebPage' : 'CollectionPage',
          '@id': canonicalUrl,
          name: title,
          description,
          url: canonicalUrl,
          image,
          isPartOf: { '@id': WEBSITE_ID },
          inLanguage: 'en',
        },
    ...(breadcrumb.length
      ? [{
          '@type': 'BreadcrumbList',
          itemListElement: breadcrumb.map((item, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            name: item.name,
            item: item.url,
          })),
        }]
      : []),
  ],
};
---
<!doctype html>
<html class="dark" lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon/favicon-48x48.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
    <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico">
    <link rel="manifest" href="/site.webmanifest">

    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={pageKind === 'notfound' ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#100F0F" />
    <title>{title}</title>
    <meta name="title" content={title}>
    <meta name="description" content={description}>

    <meta property="og:type" content={pageKind === 'article' ? 'article' : 'website'}>
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:site_name" content={SITE_NAME}>
    <meta property="og:locale" content="en_US">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={image}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:alt" content={imageAlt}>

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content={canonicalUrl}>
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={image}>
    <meta name="twitter:image:alt" content={imageAlt}>
    <meta name="twitter:creator" content="@mauwanyee">

    {pageKind === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime}>}
    {pageKind === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime}>}
    {pageKind === 'article' && section && <meta property="article:section" content={section}>}
    {pageKind === 'article' && tags.map((tag) => <meta property="article:tag" content={tag}>)}

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS`} href={absoluteUrl('/feed.xml')} />
    {markdownUrl && <link rel="alternate" type="text/markdown" href={markdownUrl} />}
    <script type="application/ld+json" set:html={jsonLdScript(jsonLd)} />
  </head>
  <body class:list={["min-h-screen flex flex-col bg-[var(--color-bg-normal)] text-[var(--color-text-normal)]", !immersive && "pt-6 pb-[10rem]"]}>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-[var(--color-bg-normal)] focus:px-4 focus:py-2">Skip to content</a>
    {!immersive && <Header />}
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    {!immersive && <Footer />}
    <script>
      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const link = target.closest<HTMLAnchorElement>('a[href^="/404?entry="]');
        if (!link) return;
        event.preventDefault();
        window.alert("This note is still germinating. Come back when it has broken through.");
      });
    </script>
  </body>
</html>
