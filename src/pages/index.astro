---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { formatDate } from "@/utils";
import ArticleList from "@/components/ArticleList.astro";
import { descriptionFromBody } from "@/lib/seo";

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => {
  return new Date(b.data.published).getTime() - new Date(a.data.published).getTime();
});
const latestPost = sortedPosts[0];

// Extract unique topics from all posts
const topics = [...new Set(posts.flatMap(post => post.data.topics || []))].sort();

// SEO metadata
const title = "Kamau Wanyee | Product Developer";
const excerpt = latestPost.data.excerpt ?? '';
const description = descriptionFromBody(
  `Product-focused full-stack developer writing about reliable tech products. ${excerpt}`
);
---

<Layout
  title={title}
  description={description}
  pageKind="home"
>
  <div class="max-w-3xl px-4 sm:px-6 pb-20 mx-auto">
    <h1 class="sr-only">Kamau Wanyee — Product Developer</h1>
    <div class="muted leading-relaxed space-y-4">
      <p>
        Product-focused full-stack developer splitting time between React Native, TypeScript services, and
        the backend glue that keeps it all running. I've figured out how to build what people actually want and now I'm learning (the hard way) how to make it reliable.
        I'm also a good translation layer between technical and non-technical stakeholders.
      </p>
      <p>
        These are my fields notes; things I've worked through, patterns I've reached for, and ideas worth writing down before I forget them.
        Currently building ambient listening and documentation software for home healthcare and hospice agencies at{" "}
        <a href="https://www.patriumhealth.com">Patrium Health</a>.
      </p>
    </div>

    <hr class="my-10" />

    <div>
      <h2 class="font-normal">
        <a href={latestPost.data.permalink} class="plain muted">Latest</a>
      </h2>

      <div class="relative w-fit">
        <a href={latestPost.data.permalink} class="plain">
          <span class="absolute inset-0"></span>
          <h2 class="text-xl">{latestPost.data.title}</h2>
        </a>
        <div class="text-sm my-2 muted flex items-center gap-2">
          <time datetime={latestPost.data.published.toISOString()}>{formatDate(latestPost.data.published.toISOString())}</time>
          {latestPost.data.minutesRead && (
            <>
              <span>&middot;</span>
              <span>{latestPost.data.minutesRead}</span>
            </>
          )}
        </div>
        <p class="muted text-sm">{excerpt} Keep reading &rarr;</p>
      </div>
    </div>

    <hr class="my-10" />

    <div>
      <h2 class="font-normal">
        <a href="/topics" class="plain muted">Topics</a>
      </h2>
      <div class="leading-relaxed mt-6">
        {
          topics.map((topic, idx) => (
            <Fragment key={topic}>
              <a href={`/topics/${topic}`}>{topic.toLowerCase()}</a>{idx < topics.length - 1 ? <span class="muted">,{" "}</span> : null}
            </Fragment>
          ))
        }
      </div>
    </div>

    <hr class="my-10" />

    <div>
      <h2 class="font-normal">
        <a href="/" class="plain muted">Notes</a>
      </h2>

      <ArticleList posts={sortedPosts} class="mt-6" />
    </div>
  </div>
</Layout>
