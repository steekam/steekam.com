---
import { formatDate } from "@/utils";
import Layout from "../layouts/Layout.astro";

const articles = [
  {
    title: "The Future of AI",
    excerpt: "The future of AI is here. Self generating ideas summary for a post.",
    date: "2024-01-01",
    formattedDate: formatDate("2024-01-01"),
    link: "/the-future-of-ai",
    readingTime: "5 minutes read",
  },
  {
    title: "Downfall of the man",
    excerpt: "The future of AI is here. Self generating ideas summary for a post.",
    date: "2023-01-01",
    formattedDate: formatDate("2023-01-01"),
    link: "/the-future-of-ai",
    readingTime: "1 minutes read",
  },
];
const latestArticle = articles[0];

const topics = ["AI", "Web Development", "Productivity", "Design", "Entrepreneurship"];
---

<Layout>
  <div class="max-w-prose pb-20 mx-auto">
    <div>
      <p>
        <a href={latestArticle.link} class="plain muted"><h2 class="font-normal">Latest</h2></a>
      </p>

      <div class="relative w-fit">
        <a href={latestArticle.link} class="plain">
          <span class="absolute inset-0"></span>
          <h2 class="text-xl">{latestArticle.title}</h2>
        </a>
        <div class="text-sm my-2 muted flex items-center gap-2">
          <time datetime="{latestArticle.date}">{latestArticle.formattedDate}</time>
          <span>&middot;</span>
          <span>{latestArticle.readingTime}</span>
        </div>
        <p class="muted text-sm">{latestArticle.excerpt} Keep reading &rarr;</p>
      </div>
    </div>

    <hr class="my-10" />

    <div>
      <a href="/topics" class="plain muted">
        <h2 class="font-normal">Topics</h2>
      </a>
      <div class="leading-relaxed mt-6">
        {
          topics.map((topic, idx) => (
            <Fragment key={topic}>
              <a href={`/topics/${topic}`}>{topic.toLowerCase()}</a>
              <span class="muted">{idx < topics.length - 1 ? "," : ""}</span>
            </Fragment>
          ))
        }
      </div>
    </div>

    <hr class="my-10" />

    <div>
      <h2 class="font-normal">
        <a href="/" class="plain muted">Notes</a>
      </h2>

      <ul class="list-none mt-6 space-y-1">
        {
          articles.map((article) => {
            const date = new Date(article.date);
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, "0");
            return (
              <li class="relative w-full flex items-baseline gap-5">
                <span class="muted whitespace-nowrap flex-shrink-1">
                  {year} · {month}
                </span>
                <a href={article.link} class="">
                  <span class="absolute inset-0" />
                  {article.title}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</Layout>
