---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { formatDate } from "@/utils";

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => {
  return new Date(b.data.published).getTime() - new Date(a.data.published).getTime();
});
const latestPost = sortedPosts[0];

// Extract unique topics from all posts
const topics = [...new Set(posts.flatMap(post => post.data.topics || []))].sort();
---

<Layout>
  <div class="max-w-prose pb-20 mx-auto">
    <div>
      <p>
        <a href={latestPost.data.permalink} class="plain muted"><h2 class="font-normal">Latest</h2></a>
      </p>

      <div class="relative w-fit">
        <a href={latestPost.data.permalink} class="plain">
          <span class="absolute inset-0"></span>
          <h2 class="text-xl">{latestPost.data.title}</h2>
        </a>
        <div class="text-sm my-2 muted flex items-center gap-2">
          <time datetime="{latestPost.data.published}">{formatDate(latestPost.data.published.toISOString())}</time>
          <span>&middot;</span>
          <span>{latestPost.data.minutesRead}</span>
        </div>
        <p class="muted text-sm">{latestPost.data.excerpt} Keep reading &rarr;</p>
      </div>
    </div>

    <hr class="my-10" />

    <div>
      <a href="/topics" class="plain muted">
        <h2 class="font-normal">Topics</h2>
      </a>
      <div class="leading-relaxed mt-6">
        {
          topics.map((topic, idx) => (
            <Fragment key={topic}>
              <a href={`/topics/${topic}`}>{topic.toLowerCase()}</a>
              <span class="muted">{idx < topics.length - 1 ? "," : ""}</span>
            </Fragment>
          ))
        }
      </div>
    </div>

    <hr class="my-10" />

    <div>
      <h2 class="font-normal">
        <a href="/" class="plain muted">Notes</a>
      </h2>

      <ul class="list-none mt-6 space-y-1">
        {
          sortedPosts.map((post) => {
            const year = post.data.published.getFullYear();
            const month = String(post.data.published.getMonth() + 1).padStart(2, "0");
            return (
              <li class="relative w-full flex items-baseline gap-5">
                <span class="muted whitespace-nowrap flex-shrink-1">
                  {year} · {month}
                </span>
                <a href={post.data.permalink} class="">
                  <span class="absolute inset-0" />
                  {post.data.title}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</Layout>
