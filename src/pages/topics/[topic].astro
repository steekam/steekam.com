---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import ArticleList from "@/components/ArticleList.astro";
import { absoluteUrl } from "@/lib/seo";

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const topics = [...new Set(posts.flatMap(post => post.data.topics || []))];

  return topics.map(topic => ({
    params: { topic },
    props: { topic },
  }));
}

interface Props {
  topic: string;
}

const { topic } = Astro.props;
const topicLabel = topic.replace(/-/g, ' ');
const posts = await getCollection('posts');
const topicPosts = posts.filter((post: CollectionEntry<'posts'>) => post.data.topics?.includes(topic));

// Sort posts by date
const sortedPosts = topicPosts.sort((a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) => {
  return new Date(b.data.published).getTime() - new Date(a.data.published).getTime();
});

// SEO metadata
const title = `${topicLabel} notes | Kamau Wanyee`;
const description = `Technical field notes about ${topicLabel} by Kamau Wanyee, focused on reliable product engineering.`;
---

<Layout
  title={title}
  description={description}
  pageKind="topic"
  breadcrumb={[
    { name: 'Home', url: absoluteUrl('/') },
    { name: 'Topics', url: absoluteUrl('/topics', true) },
    { name: topic, url: absoluteUrl(`/topics/${topic}`, true) },
  ]}
>
  <div class="max-w-3xl px-4 sm:px-6 mx-auto pb-20">
    <h1 class="text-4xl mb-8">
        <span class="muted">Topics / </span>
        {topicLabel}
    </h1>

    <p class="text-xl muted mb-4">{description}</p>

    <ArticleList posts={sortedPosts} class="mt-6" />
  </div>
</Layout>
