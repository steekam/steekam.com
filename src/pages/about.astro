---
import Layout from "../layouts/Layout.astro";

// SEO metadata
const title = "About Kamau Wanyee | Product Developer";
const description = "Learn more about Kamau Wanyee, a product developer continuously learning to build products that people want.";
---

<Layout
  title={title}
  description={description}
  type="profile"
>
  <div class="max-w-prose mx-auto pb-20">
    <h1 class="text-3xl font-normal mb-8">About Me</h1>

    <div class="prose dark:prose-invert max-w-none">
      <p>
        Hey there! 👋 I'm Kamau Wanyee, a software engineer who loves building things that make developers' lives easier. Currently, I'm at <a
          href="https://www.patriumhealth.com"
          class="">Patrium Health</a
        > helping shape the future of home based healthcare.
      </p>

      <h2>What I'm Up To</h2>
      <p>I spend my days (and sometimes nights) working on:</p>
      <ul class="list-disc list-inside">
        <li>🎨 Building products that people want to use</li>
        <li>📝 Writing about tech and sharing knowledge</li>
        <li>🌱 Contributing to open source</li>
      </ul>

      <h2>Let's Connect!</h2>
      <p>I'm always excited to meet fellow developers and tech enthusiasts. Find me on:</p>
      <ul class="list-disc list-inside">
        <li><a href="https://github.com/steekam">GitHub</a> - where I share code and contribute to open source</li>
        <li><a href="https://x.com/mauwanyee">Twitter</a> - for tech thoughts and random musings</li>
        <li><a href="https://dev.to/steekam">DEV Community</a> - sometimes I cross post other thoughts here</li>
        <li><a href="https://linkedin.com/in/swanyee" class="">LinkedIn</a> - for professional updates and connections</li>
      </ul>

      <h2>Get in Touch</h2>
      <p>
        Have a cool project idea? Want to chat about tech? Just want to say hi? I'd love to hear from you! Shoot me an email at <a
          href="mailto:kamauwanyee@gmail.com">kamauwanyee@gmail.com</a
        >.
      </p>
    </div>
  </div>
</Layout>
