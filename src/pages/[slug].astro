---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { formatDate } from "@/utils";
import { render } from "astro:content";
import { absoluteUrl, descriptionFromBody, wordCount } from "@/lib/seo";
import { postOgImage } from "@/lib/publishing";

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

// SEO metadata
const title = `${post.data.title} | Kamau Wanyee`;
const description = post.data.excerpt || descriptionFromBody(post.body ?? '', `Notes on ${post.data.title}.`);
const publishedTime = post.data.published.toISOString();
const modifiedTime = post.data.updated?.toISOString();
const image = postOgImage(post);
---
<Layout
  title={title}
  headline={post.data.title}
  description={description}
  image={image}
  pageKind="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  tags={post.data.tags}
  section={post.data.topics?.[0]}
  wordCount={wordCount(post.body ?? '')}
  imageAlt={`Social preview for ${post.data.title}`}
  breadcrumb={[
    { name: 'Home', url: absoluteUrl('/') },
    { name: post.data.title, url: absoluteUrl(post.data.permalink, true) },
  ]}
>
  <article class="max-w-3xl px-4 sm:px-6 mx-auto pb-20">
    <header class="mb-8">
      <h1 class="text-3xl font-normal mb-4">{post.data.title}</h1>
      <div class="text-sm muted flex items-center gap-2">
        <span>By <a href="/" rel="author">Kamau Wanyee</a></span>
        <span>&middot;</span>
        <time datetime={post.data.published.toISOString()}>
          {formatDate(post.data.published.toISOString())}
        </time>
        {post.data.updated && (
          <>
            <span>&middot;</span>
            <time datetime={post.data.updated.toISOString()}>
              Updated at {formatDate(post.data.updated.toISOString())}
            </time>
          </>
        )}
        {post.data.minutesRead && (
          <div class="flex items-center gap-2">
            <span>&middot;</span>
            <span>{post.data.minutesRead}</span>
          </div>
        )}
      </div>
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="mt-4 flex gap-2">
          {post.data.tags.map((tag: string) => (
            <span class="text-sm bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <div class="prose dark:prose-invert max-w-none">
      <Content />
    </div>
  </article>
</Layout>
