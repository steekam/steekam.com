---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { formatDate } from "@/utils";
import { render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

// SEO metadata
const title = `${post.data.title} | Kamau Wanyee`;
const description = post.data.excerpt || `Read about ${post.data.title} by Kamau Wanyee`;
const publishedTime = post.data.published.toISOString();
const image = new URL(`/og/${post.id}.png`, Astro.site).href;
---
<Layout
  title={title}
  description={description}
  image={image}
  type="article"
  publishedTime={publishedTime}
>
  <article class="max-w-prose mx-auto pb-20">
    <header class="mb-8">
      <h1 class="text-3xl font-normal mb-4">{post.data.title}</h1>
      <div class="text-sm muted flex items-center gap-2">
        <time datetime={post.data.published.toISOString()}>
          {formatDate(post.data.published.toISOString())}
        </time>
        {post.data.minutesRead && (
          <div class="flex items-center gap-2">
            <span>&middot;</span>
            <span>{post.data.minutesRead}</span>
          </div>
        )}
      </div>
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="mt-4 flex gap-2">
          {post.data.tags.map((tag: string) => (
            <span class="text-sm bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <div class="prose dark:prose-invert max-w-none">
      <Content />
    </div>
  </article>
</Layout>
