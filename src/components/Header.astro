---
import { Icon } from "astro-icon/components";
import bonsaiIcon from '@/assets/noun-bonsai-6879622.optimized.svg';
---

<header class="w-full py-4 mb-8">
  <div class="flex justify-between items-center max-w-3xl px-4 sm:px-6 mx-auto">
    <div>
      <a href="/" class="internal-link plain flex items-center gap-2 font-medium text-lg">
        <span class="site-mark" aria-hidden="true">
          <img src={bonsaiIcon.src} alt="" />
        </span>
        <span>Kamau Wanyee</span>
      </a>
    </div>

    <nav aria-label="Primary" class="flex items-center gap-4">
      <a href="/" class="internal-link">Notes</a>
      <a href="/topics" class="internal-link">Topics</a>
      <div
        class="relative flex items-center"
        x-data="theme">
        <div x-cloak class="absolute inset-start-0 h-4 w-4 text-[var(--color-text-normal)]">
          <Icon name="lucide:monitor" class="w-full h-full" :class="{ 'hidden': theme !== 'system' }" />
          <Icon name="lucide:moon" class="w-full h-full" :class="{ 'hidden': theme !== 'dark' }" />
          <Icon name="lucide:sun" class="w-full h-full" :class="{ 'hidden': theme !== 'light' }" />
        </div>
        <label for="theme-switcher" class="sr-only">Theme switcher</label>
        <select x-model="theme" id="theme-switcher" class="pl-5 focus:outline-none focus:ring focus:ring-[var(--color-action)]">
          <option value="light">Light</option>
          <option value="dark">Dark</option>
          <option value="system">System</option>
        </select>
      </div>
    </nav>
  </div>
</header>
