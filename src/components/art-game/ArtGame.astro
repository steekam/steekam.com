---
import artworkData from './artwork-data.json';

const entries = artworkData;
const gameJson = JSON.stringify(entries).replace(/</g, '\\u003c');
---

<section class="art-game" data-art-game data-testid="art-game-root" aria-labelledby="art-game-title">
  <div class="art-game__grain" aria-hidden="true"></div>
  <div class="art-game__inner">
    <header class="art-game__masthead">
      <a class="art-game__back" href="/projects">← Projects</a>
      <p class="art-game__eyebrow">An unofficial art-spotting game</p>
      <div class="art-game__mark" aria-hidden="true">HAW</div>
    </header>

    <section class="art-game__screen art-game__intro" data-screen="intro" data-testid="screen-intro">
      <div class="art-game__intro-copy">
        <p class="art-game__kicker">The after-hours collection · 08 works</p>
        <h1 id="art-game-title">Horsin’<br /><em>around</em> with art.</h1>
        <p class="art-game__lede">The paintings in BoJack’s world have been quietly borrowing from art history. Can you spot the originals hiding in the frame?</p>
        <button class="art-game__button art-game__button--primary" type="button" data-action="start" data-testid="start-game">
          Enter the gallery <span aria-hidden="true">↗</span>
        </button>
        <p class="art-game__smallprint">Eight references · no horse sense required</p>
      </div>
      <div class="art-game__intro-art" aria-label="Abstract gallery preview" role="img">
        <div class="art-game__sun"></div>
        <div class="art-game__water"></div>
        <div class="art-game__figure"></div>
        <div class="art-game__frame art-game__frame--one"><span>01</span></div>
        <div class="art-game__frame art-game__frame--two"><span>?</span></div>
        <p class="art-game__caption">A museum for paintings<br />that know too much.</p>
      </div>
    </section>

    <section class="art-game__screen art-game__play" data-screen="play" data-testid="screen-play" hidden>
      <div class="art-game__progress-row">
        <p class="art-game__kicker" data-testid="round-label">Round 01 / 08</p>
        <p class="art-game__score"><span data-testid="score">0</span> correct</p>
      </div>
      <div class="art-game__progress" aria-hidden="true"><span data-testid="progress-bar"></span></div>

      <div class="art-game__question-grid">
        <figure class="art-game__scene-card">
          <div class="art-game__card-label"><span>Scene study</span><span data-testid="episode">S01E01</span></div>
          <div class="art-game__image-wrap art-game__image-wrap--scene">
            <img data-testid="scene-image" src="" alt="" loading="eager" />
            <span class="art-game__image-fallback" data-testid="scene-fallback" hidden>Scene study unavailable. Read the clue below.</span>
          </div>
          <figcaption data-testid="scene-caption">A visual clue from the show’s orbit.</figcaption>
        </figure>

        <div class="art-game__prompt">
          <p class="art-game__kicker">Look closely</p>
          <h2>Which real artwork is<br /><em>hiding here?</em></h2>
          <p class="art-game__hint">Choose one. The frame will tell you if you’re right.</p>
          <div class="art-game__choices" role="group" aria-label="Artwork choices" data-testid="answer-choices">
            <button class="art-game__choice" type="button" data-choice="0" data-testid="answer-option-0"><span class="art-game__choice-letter">A</span><span data-choice-label="0"></span></button>
            <button class="art-game__choice" type="button" data-choice="1" data-testid="answer-option-1"><span class="art-game__choice-letter">B</span><span data-choice-label="1"></span></button>
            <button class="art-game__choice" type="button" data-choice="2" data-testid="answer-option-2"><span class="art-game__choice-letter">C</span><span data-choice-label="2"></span></button>
          </div>
          <p class="art-game__status" data-testid="answer-status" aria-live="polite"></p>
        </div>
      </div>

      <article class="art-game__reveal" data-testid="reveal-panel" hidden>
        <div class="art-game__reveal-heading">
          <p class="art-game__kicker" data-testid="reveal-kicker">The frame opens</p>
          <h2 data-testid="reveal-title"></h2>
        </div>
        <div class="art-game__comparison">
          <figure>
          <div class="art-game__image-wrap"><img data-testid="reveal-scene-image" src="" alt="" loading="lazy" /><span class="art-game__image-fallback" data-testid="reveal-scene-fallback" hidden>Scene study unavailable. Read the comparison notes below.</span></div>
            <figcaption>BoJack’s orbit</figcaption>
          </figure>
          <div class="art-game__versus" aria-hidden="true">↔</div>
          <figure>
            <div class="art-game__image-wrap"><img data-testid="reveal-art-image" src="" alt="" loading="lazy" /><span class="art-game__image-fallback" data-testid="reveal-art-fallback" hidden>Reference image unavailable. Read the attribution below.</span></div>
            <figcaption>Reference · <span data-testid="reveal-artist"></span></figcaption>
          </figure>
        </div>
        <div class="art-game__reveal-copy">
          <p data-testid="reveal-text"></p>
          <div class="art-game__notes">
            <div><span class="art-game__note-label">Why it lands</span><p data-testid="scene-note"></p></div>
            <div><span class="art-game__note-label">A tiny art fact</span><p data-testid="art-fact"></p></div>
          </div>
          <p class="art-game__credit" data-testid="image-credit"></p>
          <div class="art-game__source-list" data-testid="sources"></div>
        </div>
        <button class="art-game__button art-game__button--secondary" type="button" data-action="next" data-testid="next-round">Next frame <span aria-hidden="true">→</span></button>
      </article>
    </section>

    <section class="art-game__screen art-game__complete" data-screen="complete" data-testid="screen-complete" hidden>
      <div class="art-game__complete-heading">
        <p class="art-game__kicker">Collection complete</p>
        <h2>You made it through<br /><em>the frame.</em></h2>
        <p class="art-game__result" data-testid="final-result" tabindex="-1" role="status" aria-live="polite"></p>
      </div>
      <div class="art-game__wall" data-testid="gallery-wall" aria-label="Your collected artworks"></div>
      <div class="art-game__complete-actions">
        <button class="art-game__button art-game__button--primary" type="button" data-action="replay" data-testid="replay-game">Play again <span aria-hidden="true">↗</span></button>
        <p class="art-game__smallprint">Thanks for visiting. Please tip the curator.</p>
      </div>
    </section>

    <footer class="art-game__footer">
      <p>Made with affection for art references, difficult horses, and museum labels.</p>
      <p>Unofficial fan project · Not affiliated with Netflix or the creators of BoJack Horseman.</p>
    </footer>
  </div>
</section>

<script is:inline define:vars={{ gameJson }}>
  const entries = JSON.parse(gameJson);
  const root = document.querySelector('[data-art-game]');
  if (root) {
    const storageKey = 'steekam-horsin-around-art-v1';
    const screens = [...root.querySelectorAll('[data-screen]')];
    const sceneImage = root.querySelector('[data-testid="scene-image"]');
    const fallback = root.querySelector('[data-testid="scene-fallback"]');
    const revealPanel = root.querySelector('[data-testid="reveal-panel"]');
    const revealScene = root.querySelector('[data-testid="reveal-scene-image"]');
    const revealArt = root.querySelector('[data-testid="reveal-art-image"]');
    const revealSceneFallback = root.querySelector('[data-testid="reveal-scene-fallback"]');
    const revealArtFallback = root.querySelector('[data-testid="reveal-art-fallback"]');
    const choices = [...root.querySelectorAll('[data-choice]')];
    const state = { started: false, index: 0, score: 0, selected: null, revealed: false, completed: [] };

    const defaultState = () => ({ started: false, index: 0, score: 0, selected: null, revealed: false, completed: [] });
    const normalizeState = (candidate) => {
      if (!candidate || typeof candidate !== 'object') return defaultState();
      const validCompleted = Array.isArray(candidate.completed) && candidate.completed.every((value) => Number.isInteger(value) && value >= 0 && value < entries.length);
      const completed = validCompleted ? [...new Set(candidate.completed)] : [];
      const validStarted = typeof candidate.started === 'boolean';
      const validIndex = Number.isInteger(candidate.index) && candidate.index >= 0 && candidate.index < entries.length;
      const validScore = Number.isInteger(candidate.score) && candidate.score >= 0 && candidate.score <= completed.length;
      const validSelected = candidate.selected === null || (Number.isInteger(candidate.selected) && candidate.selected >= 0 && candidate.selected < 3);
      const validRevealed = typeof candidate.revealed === 'boolean';
      if (!validCompleted || !validStarted || !validIndex || !validScore || !validSelected || !validRevealed) return defaultState();
      if (candidate.revealed && (candidate.selected === null || !completed.includes(candidate.index))) return defaultState();
      return candidate.started ? { started: true, index: candidate.index, score: candidate.score, selected: candidate.revealed ? candidate.selected : null, revealed: candidate.revealed, completed } : defaultState();
    };
    const readState = () => {
      try {
        const saved = JSON.parse(localStorage.getItem(storageKey) || 'null');
        Object.assign(state, normalizeState(saved));
      } catch (error) {
        localStorage.removeItem(storageKey);
        Object.assign(state, defaultState());
      }
    };
    const saveState = () => localStorage.setItem(storageKey, JSON.stringify(state));
    const text = (selector, value) => { const element = root.querySelector(selector); if (element) element.textContent = value; };
    const showScreen = (name) => screens.forEach((screen) => { screen.hidden = screen.dataset.screen !== name; });
    const setImage = (image, fallbackElement, source, alt) => {
      image.onerror = () => { image.hidden = true; fallbackElement.hidden = false; };
      image.hidden = false;
      fallbackElement.hidden = true;
      image.alt = alt;
      image.src = source;
    };

    const updateWall = () => {
      const wall = root.querySelector('[data-testid="gallery-wall"]');
      if (!wall) return;
      wall.replaceChildren(...state.completed.map((entryIndex, frameIndex) => {
        const entry = entries[entryIndex];
        const frame = document.createElement('figure');
        frame.className = `art-game__wall-frame art-game__wall-frame--${(frameIndex % 4) + 1}`;
        const image = document.createElement('img');
        image.src = entry.artImage;
        image.alt = entry.artAlt;
        const caption = document.createElement('figcaption');
        const number = document.createElement('span');
        number.textContent = String(frameIndex + 1).padStart(2, '0');
        caption.append(number, document.createTextNode(` · ${entry.artist}`));
        frame.append(image, caption);
        return frame;
      }));
    };

    const curatorTitle = (score) => score <= 2 ? 'Todd wandered into the museum.' : score <= 4 ? 'Hollywoo gallery intern.' : score <= 6 ? 'Princess Carolyn on exhibition deadline.' : 'Diane wrote the catalogue.';
    const renderRound = () => {
      const entry = entries[state.index];
      text('[data-testid="round-label"]', `Round ${String(state.index + 1).padStart(2, '0')} / ${String(entries.length).padStart(2, '0')}`);
      text('[data-testid="score"]', String(state.score));
      text('[data-testid="episode"]', entry.episode);
      text('[data-testid="scene-caption"]', entry.sceneAlt);
      text('[data-testid="reveal-artist"]', `${entry.artist} · ${entry.title}, ${entry.year}`);
      root.querySelector('[data-testid="progress-bar"]').style.width = `${((state.index + (state.revealed ? 1 : 0)) / entries.length) * 100}%`;
      setImage(sceneImage, fallback, entry.sceneImage, entry.sceneAlt);
      choices.forEach((choice, choiceIndex) => {
        choice.querySelector('[data-choice-label]').textContent = entry.choices[choiceIndex];
        choice.classList.remove('is-selected', 'is-correct', 'is-wrong');
        choice.disabled = state.revealed;
        if (state.selected === choiceIndex) choice.classList.add('is-selected');
        if (state.revealed && choiceIndex === entry.correctChoice) choice.classList.add('is-correct');
        if (state.revealed && state.selected === choiceIndex && choiceIndex !== entry.correctChoice) choice.classList.add('is-wrong');
      });
      revealPanel.hidden = !state.revealed;
      if (state.revealed) {
        text('[data-testid="reveal-kicker"]', state.selected === entry.correctChoice ? 'A good eye' : 'The frame opens');
        text('[data-testid="reveal-title"]', `${entry.artist} · ${entry.title}`);
        text('[data-testid="reveal-text"]', entry.reveal);
        text('[data-testid="scene-note"]', entry.sceneNote);
        text('[data-testid="art-fact"]', entry.artFact);
        text('[data-testid="image-credit"]', `${entry.imageCredit} ${entry.imageLicense} Rights note: ${entry.imageRights} Accessed ${entry.imageAccessed}.`);
        setImage(revealScene, revealSceneFallback, entry.sceneImage, entry.sceneAlt);
        setImage(revealArt, revealArtFallback, entry.artImage, entry.artAlt);
        const sourceList = root.querySelector('[data-testid="sources"]');
        sourceList.replaceChildren(...entry.sources.map((source) => { const link = document.createElement('a'); link.href = source.url; link.target = '_blank'; link.rel = 'noopener noreferrer'; link.textContent = source.label; return link; }));
        text('[data-testid="answer-status"]', state.selected === entry.correctChoice ? 'Correct. The frame was waiting for you.' : `Not this time. The answer was ${entry.artist}.`);
        root.querySelector('[data-testid="next-round"]').focus();
      } else {
        text('[data-testid="answer-status"]', '');
      }
    };
    const showComplete = () => {
      showScreen('complete');
      text('[data-testid="final-result"]', `${state.score} / ${entries.length} frames identified · ${curatorTitle(state.score)}`);
      updateWall();
      root.querySelector('[data-testid="final-result"]').focus();
    };
    const start = () => { state.started = true; state.index = 0; state.selected = null; state.revealed = false; saveState(); showScreen('play'); renderRound(); root.querySelector('[data-testid="answer-option-0"]').focus(); };
    root.querySelector('[data-action="start"]').addEventListener('click', start);
    root.querySelector('[data-action="replay"]').addEventListener('click', () => { localStorage.removeItem(storageKey); Object.assign(state, { started: true, index: 0, score: 0, selected: null, revealed: false, completed: [] }); saveState(); showScreen('play'); renderRound(); root.querySelector('[data-testid="answer-option-0"]').focus(); });
    choices.forEach((choice) => choice.addEventListener('click', () => {
      if (state.revealed) return;
      state.selected = Number(choice.dataset.choice);
      state.revealed = true;
      if (state.selected === entries[state.index].correctChoice) state.score += 1;
      state.completed = [...new Set([...state.completed, state.index])];
      saveState(); renderRound();
    }));
    root.querySelector('[data-action="next"]').addEventListener('click', () => {
      if (!state.revealed) return;
      if (state.index >= entries.length - 1) { saveState(); showComplete(); return; }
      state.index += 1; state.selected = null; state.revealed = false; saveState(); renderRound(); root.querySelector('[data-testid="answer-option-0"]').focus();
    });
    readState();
    if (state.completed.length >= entries.length) showComplete();
    else if (state.started) { showScreen('play'); renderRound(); }
    else showScreen('intro');
  }
</script>

<style>
  .art-game { --ink: #18231f; --muted: #637069; --cream: #f2eadb; --paper: #f8f4eb; --green: #173c34; --green-2: #286052; --red: #bc5a4d; --gold: #d9af65; --blue: #75c9d5; min-height: 100vh; overflow: hidden; position: relative; background: var(--cream); color: var(--ink); font-family: Georgia, 'Times New Roman', serif; }
  .art-game__grain { position: absolute; inset: 0; opacity: .08; pointer-events: none; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.3'/%3E%3C/svg%3E"); mix-blend-mode: multiply; }
  .art-game__inner { max-width: 1180px; margin: 0 auto; min-height: 100vh; padding: 28px clamp(20px, 4vw, 64px) 36px; position: relative; z-index: 1; display: flex; flex-direction: column; }
  .art-game__masthead { display: flex; align-items: center; justify-content: space-between; gap: 20px; border-bottom: 1px solid rgba(24,35,31,.2); padding-bottom: 18px; }
  .art-game__back, .art-game__eyebrow, .art-game__kicker, .art-game__smallprint, .art-game__caption, .art-game__card-label, .art-game__progress-row, .art-game__footer, .art-game__credit, .art-game__source-list, .art-game__note-label { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; letter-spacing: .06em; text-transform: uppercase; }
  .art-game__back { color: var(--ink); font-size: .65rem; text-decoration: none; transition: color .2s ease; }
  .art-game__back:hover { color: var(--red); }
  .art-game__eyebrow { margin: 0; color: var(--muted); font-size: .62rem; }
  .art-game__mark { width: 38px; height: 38px; display: grid; place-items: center; border: 1px solid var(--ink); border-radius: 50%; font: 700 .62rem ui-monospace, monospace; transform: rotate(-9deg); }
  .art-game__screen { flex: 1; }
  .art-game__intro { min-height: min(740px, calc(100vh - 150px)); display: grid; grid-template-columns: minmax(0, 1fr) minmax(320px, .85fr); gap: clamp(28px, 7vw, 110px); align-items: center; padding: clamp(50px, 8vw, 100px) 0 60px; }
  .art-game__intro-copy { position: relative; z-index: 2; }
  .art-game__kicker { margin: 0 0 22px; color: var(--green-2); font-size: .65rem; font-weight: 700; }
  .art-game h1, .art-game h2 { margin: 0; color: var(--green); font-weight: 500; letter-spacing: -.055em; line-height: .92; }
  .art-game h1 { max-width: 680px; font-size: clamp(4rem, 10vw, 8.4rem); }
  .art-game h1 em, .art-game h2 em { color: var(--red); font-style: italic; font-weight: 400; }
  .art-game__lede { max-width: 440px; margin: 32px 0 30px; font-size: clamp(1.05rem, 1.9vw, 1.35rem); line-height: 1.5; }
  .art-game__smallprint { margin: 14px 0 0; color: var(--muted); font-size: .58rem; }
  .art-game__button { appearance: none; border: 0; cursor: pointer; font: 700 .68rem ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; transition: transform .2s ease, background .2s ease, box-shadow .2s ease; }
  .art-game__button:hover { transform: translateY(-3px); }
  .art-game__button:focus-visible, .art-game__choice:focus-visible, .art-game__back:focus-visible { outline: 3px solid var(--red); outline-offset: 4px; }
  .art-game__button--primary { padding: 17px 21px; background: var(--green); color: var(--paper); box-shadow: 5px 5px 0 var(--gold); }
  .art-game__button--primary:hover { background: var(--red); box-shadow: 5px 5px 0 var(--green); }
  .art-game__button--secondary { margin-top: 28px; padding: 14px 18px; color: var(--paper); background: var(--green); }
  .art-game__intro-art { min-height: 470px; position: relative; overflow: hidden; background: var(--green); box-shadow: 14px 14px 0 rgba(24,35,31,.12); transform: rotate(2deg); }
  .art-game__sun { position: absolute; width: 160px; height: 160px; border-radius: 50%; top: 11%; right: 9%; background: var(--gold); }
  .art-game__water { position: absolute; inset: 45% -10% -10%; background: repeating-linear-gradient(172deg, transparent 0 25px, rgba(117,201,213,.72) 26px 29px); transform: rotate(-4deg); }
  .art-game__figure { position: absolute; width: 110px; height: 240px; left: 38%; bottom: 8%; border-radius: 48% 48% 10% 10%; background: var(--red); transform: rotate(10deg); }
  .art-game__figure::before { content: ''; position: absolute; width: 94px; height: 94px; top: -53px; left: 5px; border-radius: 50%; background: var(--red); }
  .art-game__frame { position: absolute; width: 120px; height: 158px; border: 9px solid var(--gold); background: var(--blue); box-shadow: 5px 5px 0 rgba(0,0,0,.2); color: var(--paper); display: grid; place-items: end; padding: 8px; font: 700 .64rem ui-monospace, monospace; }
  .art-game__frame--one { top: 22%; left: -35px; transform: rotate(-13deg); }
  .art-game__frame--two { bottom: -28px; right: -24px; transform: rotate(9deg); background: var(--red); }
  .art-game__caption { position: absolute; left: 24px; bottom: 20px; color: var(--paper); font-size: .56rem; line-height: 1.7; }
  .art-game__progress-row { display: flex; justify-content: space-between; margin: 52px 0 10px; color: var(--muted); font-size: .62rem; }
  .art-game__progress-row p { margin: 0; }
  .art-game__score { color: var(--green); }
  .art-game__progress { height: 5px; background: rgba(24,35,31,.12); }
  .art-game__progress span { display: block; height: 100%; width: 0; background: var(--red); transition: width .4s ease; }
  .art-game__question-grid { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(320px, .92fr); gap: clamp(32px, 6vw, 90px); align-items: center; padding: 56px 0 44px; }
  .art-game__scene-card { margin: 0; background: var(--green); padding: 15px 15px 17px; color: var(--paper); transform: rotate(-1.5deg); box-shadow: 12px 12px 0 rgba(24,35,31,.12); }
  .art-game__card-label { display: flex; justify-content: space-between; color: var(--gold); font-size: .57rem; padding: 0 2px 11px; }
  .art-game__image-wrap { position: relative; overflow: hidden; background: var(--base, #cad1c5); aspect-ratio: 1.5; }
  .art-game__image-wrap img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .art-game__image-wrap--scene { aspect-ratio: 1.42; }
  .art-game__image-fallback { position: absolute; inset: 0; display: grid; place-items: center; padding: 20px; text-align: center; font: .72rem ui-monospace, monospace; color: var(--green); background: var(--cream); }
  .art-game__scene-card figcaption { margin-top: 13px; color: rgba(248,244,235,.75); font: .6rem ui-monospace, monospace; line-height: 1.5; }
  .art-game__prompt h2 { font-size: clamp(2.8rem, 6vw, 5.2rem); }
  .art-game__hint { margin: 22px 0 25px; color: var(--muted); line-height: 1.45; }
  .art-game__choices { display: grid; gap: 10px; }
  .art-game__choice { display: grid; grid-template-columns: 32px 1fr; gap: 10px; align-items: center; padding: 14px 13px; border: 1px solid rgba(24,35,31,.25); background: rgba(248,244,235,.5); color: var(--ink); cursor: pointer; text-align: left; font: .92rem Georgia, serif; transition: background .18s ease, border-color .18s ease, transform .18s ease; }
  .art-game__choice:hover:not(:disabled) { border-color: var(--red); transform: translateX(5px); }
  .art-game__choice:disabled { cursor: default; }
  .art-game__choice-letter { display: grid; width: 26px; height: 26px; place-items: center; border: 1px solid currentColor; border-radius: 50%; font: .64rem ui-monospace, monospace; }
  .art-game__choice.is-correct { border-color: var(--green-2); background: #dbe6d6; }
  .art-game__choice.is-wrong { border-color: var(--red); background: #f1d9d0; }
  .art-game__choice.is-selected { box-shadow: inset 5px 0 0 var(--red); }
  .art-game__status { min-height: 22px; margin: 15px 0 0; color: var(--red); font: .64rem ui-monospace, monospace; line-height: 1.5; }
  .art-game__reveal { border-top: 1px solid rgba(24,35,31,.22); padding: 52px 0 64px; }
  .art-game__reveal-heading h2 { max-width: 850px; font-size: clamp(2.5rem, 5.8vw, 5.8rem); }
