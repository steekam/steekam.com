---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@/utils';

interface Props {
  posts: CollectionEntry<"posts">[];
  class?: string;
}

const { posts, class: className } = Astro.props;
---

<ul class:list={["list-none space-y-1", className]}>
  {
    posts.map((post) => {
      return (
        <li class="relative w-full flex items-baseline gap-5">
          <span class="muted whitespace-nowrap flex-shrink-1">
            {post.data.published.toISOString().slice(0, 10)}
          </span>
          <a href={post.data.permalink} class="">
            <span class="absolute inset-0" />
            {post.data.title}
          </a>
        </li>
      );
    })
  }
</ul>
