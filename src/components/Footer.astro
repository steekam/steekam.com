---
import { Icon } from 'astro-icon/components';
---

<footer class="w-full">
    <div class="max-w-3xl px-4 sm:px-6 pt-8 mx-auto border-t border-[var(--color-ui-normal)]">
        <div class="flex justify-center space-x-6 items-center">
          <a
            href="https://x.com/mauwanyee"
            target="_blank"
            rel="noopener noreferrer"
            class="internal-link"
          >
            <Icon name="lucide:twitter" class="h-5 w-5" />
            <span class="sr-only">Twitter</span>
          </a>

          <a
            href="https://linkedin.com/in/swanyee"
            target="_blank"
            rel="noopener noreferrer"
            class="internal-link"
          >
            <Icon name="lucide:linkedin" class="h-5 w-5" />
            <span class="sr-only">LinkedIn</span>
          </a>

          <a
            href="https://github.com/steekam"
            target="_blank"
            rel="noopener noreferrer"
            class="internal-link"
          >
            <Icon name="lucide:github" class="h-5 w-5" />
            <span class="sr-only">GitHub</span>
          </a>

          <a
            href="https://dev.to/steekam"
            target="_blank"
            rel="noopener noreferrer"
            class="internal-link"
          >
            <Icon name="lucide:rss" class="h-5 w-5" />
            <span class="sr-only">DEV Community</span>
          </a>
        </div>
        <p class="text-center text-sm text-neutral-400 dark:text-neutral-500 mt-6 mb-8">
          © <span x-data x-text="new Date().getFullYear()">2026</span> steekam
        </p>
    </div>
  </footer>
