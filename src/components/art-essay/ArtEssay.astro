---
import story from './story-data.json';

const chapters = story;
const hero = chapters[1];
---

<article class="art-essay" data-art-essay data-testid="art-essay-root" style={`--essay-accent: ${hero.accent}`}>
  <header class="essay-nav">
    <a class="essay-nav__back" href="/projects">Projects</a>
    <p class="essay-nav__label">A visual essay in five rooms</p>
    <div class="essay-nav__tools">
      <div class="essay-mode" role="group" aria-label="View mode">
        <button class="essay-mode__button is-selected" type="button" data-mode="essay" aria-pressed="true">Essay</button>
        <button class="essay-mode__button" type="button" data-mode="gallery" aria-pressed="false">Gallery</button>
      </div>
      <a class="essay-nav__index" href="#chapter-index" aria-label="Jump to chapter index">Index</a>
    </div>
  </header>

  <section class="essay-hero" data-testid="essay-hero" aria-labelledby="essay-title">
    <img class="essay-hero__scene" src={hero.sceneImage} alt={hero.sceneAlt} fetchpriority="high" />
    <div class="essay-hero__veil" aria-hidden="true"></div>
    <div class="essay-hero__art-plane" aria-hidden="true">
      <img src={hero.artImage} alt="" />
    </div>
    <div class="essay-hero__copy">
      <h1 id="essay-title">The art<br /><em>in the background.</em></h1>
      <p class="essay-hero__thesis">BoJack Horseman fills its rooms with art jokes. Some land twice: first as parody, then as part of the scene.</p>
      <a class="essay-hero__start" href="#chapter-index">Read the essay <span aria-hidden="true">↓</span></a>
    </div>
    <p class="essay-hero__credit">Scene: BoJack Horseman / Netflix · S1E02 office image via DailyArt</p>
  </section>

  <section class="essay-intro" id="chapter-index" aria-labelledby="intro-title">
    <div class="essay-intro__grid">
      <h2 id="intro-title">The joke is<br />hanging on<br /><em>the wall.</em></h2>
      <div>
        <p>Famous paintings appear in offices, restaurants, bedrooms, and rehab. Their placement adds a second reading to scenes about vanity, distance, escape, danger, and recovery.</p>
        <p class="essay-intro__note">Spoilers for seasons 1–6. Scroll at your own pace; the image changes when the story does.</p>
      </div>
    </div>
    <nav class="chapter-index" aria-label="Essay chapters">
      {chapters.map((chapter) => <a href={`#chapter-${chapter.id}`}><span>{chapter.number}</span><span>{chapter.artist} · {chapter.artwork}</span></a>)}
    </nav>
  </section>

  <section class="essay-gallery" data-gallery hidden aria-labelledby="gallery-title">
    <div class="essay-gallery__intro">
      <h2 id="gallery-title">Scenes and paintings,<br /><em>side by side.</em></h2>
      <p>Five scenes. Five paintings. Move across an image to draw the seam between the joke on screen and the work it borrows from.</p>
    </div>
    <div class="gallery-grid">
      {chapters.map((chapter, index) => (
        <article class="gallery-item" data-gallery-item={chapter.id} style={`--chapter-accent: ${chapter.accent}; --gallery-index: ${index}`}>
          <button class="gallery-item__open" type="button" data-open-dialog={chapter.id} aria-label={`Open details for ${chapter.title}`}>
            <span class="gallery-item__pair" data-seam-pair style="--gallery-seam: 50%">
              <img class="gallery-item__scene" src={chapter.sceneImage} alt={chapter.sceneAlt} loading="eager" />
              <span class="gallery-item__art-mask" aria-hidden="true"><img class="gallery-item__art" src={chapter.artImage} alt="" loading="eager" /></span>
              <span class="gallery-item__seam" aria-hidden="true"></span>
            </span>
            <span class="gallery-item__title">{chapter.title}</span>
            <span class="gallery-item__meta"><span>{chapter.season}</span><span>{chapter.artist}</span></span>
            <span class="gallery-item__hint">Open the room <span aria-hidden="true">↗</span></span>
          </button>
        </article>
      ))}
    </div>
  </section>

  <aside class="essay-threshold essay-threshold--arrival" aria-label="Editorial interlude">
    <figure>
      <img src="/images/horsin-around-with-art/generated/threshold-arrival.png" alt="A dark paper collage with a lit doorway and a loose fragment of a painted figure." loading="lazy" />
      <figcaption><span>Generated editorial illustration</span><span>The restaurant gag opens into a longer pattern.</span></figcaption>
    </figure>
  </aside>

  <div class="essay-chapters">
    {chapters.map((chapter, index) => (
      <section class="essay-chapter" id={`chapter-${chapter.id}`} data-chapter={chapter.id} data-index={index} style={`--chapter-accent: ${chapter.accent}`} aria-labelledby={`chapter-title-${chapter.id}`}>
        <div class="essay-chapter__media" data-testid={`chapter-media-${chapter.id}`}>
          <div class="essay-chapter__media-meta"><span>{chapter.season}</span><span>{chapter.location}</span></div>
          <div class="essay-chapter__visual">
            <img class="essay-chapter__scene" src={chapter.sceneImage} alt={chapter.sceneAlt} loading={index === 0 ? 'eager' : 'lazy'} />
            <img class="essay-chapter__art" src={chapter.artImage} alt={chapter.artAlt} loading="lazy" />
          </div>
          <div class="essay-chapter__caption"><span>Scene → artwork</span><span>{chapter.artist}, {chapter.year}</span></div>
        </div>
        <div class="essay-chapter__copy">
          <h2 id={`chapter-title-${chapter.id}`}>{chapter.title}</h2>
          <p class="essay-chapter__lede">{chapter.lede}</p>
          <div class="essay-chapter__story"><p>{chapter.story}</p></div>
          <blockquote>{chapter.reading}</blockquote>
          <div class="essay-chapter__credits">
            <p><strong>In the frame</strong>{chapter.sceneCredit}</p>
            <p><strong>On the wall</strong>{chapter.artCredit}</p>
            <p><strong>Reading note</strong>{chapter.rights}{' '}Sources document the scene and artwork. The essay identifies its own interpretations.</p>
          </div>
          <nav class="essay-chapter__sources" aria-label={`Sources for ${chapter.artist}`}>
            <span>Sources</span>
            {chapter.sources.map((source) => <a href={source.url} target="_blank" rel="noreferrer">{source.label}<span aria-hidden="true">↗</span></a>)}
          </nav>
        </div>
      </section>
    ))}
  </div>

  {chapters.map((chapter) => (
    <dialog class="art-dialog" data-art-dialog={chapter.id} aria-labelledby={`dialog-title-${chapter.id}`} style={`--chapter-accent: ${chapter.accent}`}>
      <div class="art-dialog__body">
        <button class="art-dialog__close" type="button" data-close-dialog>Close</button>
        <div class="art-dialog__heading">
          <h2 id={`dialog-title-${chapter.id}`}>{chapter.title}</h2>
          <p>{chapter.season} · {chapter.episode} · {chapter.location}</p>
        </div>
        <div class="art-dialog__images">
          <figure><img src={chapter.sceneImage} alt={chapter.sceneAlt} loading="lazy" /><figcaption>In the frame · BoJack Horseman</figcaption></figure>
          <figure><img src={chapter.artImage} alt={chapter.artAlt} loading="lazy" /><figcaption>On the wall · {chapter.artist}, {chapter.year}</figcaption></figure>
        </div>
        <div class="art-dialog__copy">
          <p class="art-dialog__lede">{chapter.lede}</p>
          <p>{chapter.story}</p>
          <blockquote>{chapter.reading}</blockquote>
        </div>
        <div class="art-dialog__sources">
          <p>Credits & sources</p>
          <p>{chapter.sceneCredit}</p>
          <p>{chapter.artCredit}</p>
          <p>{chapter.rights}</p>
          <nav aria-label={`Sources for ${chapter.artist}`}>
            {chapter.sources.map((source) => <a href={source.url} target="_blank" rel="noreferrer">{source.label}<span aria-hidden="true">↗</span></a>)}
          </nav>
        </div>
      </div>
    </dialog>
  ))}

  <aside class="essay-threshold essay-threshold--warning" aria-label="Editorial interlude">
    <figure>
      <img src="/images/horsin-around-with-art/generated/threshold-warning.png" alt="A dark river at dusk with floating flowers and a torn blank paper fragment." loading="lazy" />
      <figcaption><span>Generated editorial illustration</span><span>Flowers drift through dark water before the Ophelia chapter.</span></figcaption>
    </figure>
  </aside>

  <footer class="essay-coda" aria-labelledby="coda-title">
    <h2 id="coda-title">The painting<br />changes<br /><em>the scene.</em></h2>
    <p>These references do not explain the characters. They add specific images to what happens around them: two figures divided by a pool, a bridge that falls from the wall, a body among flowers, a self-portrait in rehab. The scene ends. The image remains.</p>
    <a href="#essay-title">Back to the beginning <span aria-hidden="true">↑</span></a>
    <p class="essay-coda__disclaimer">An unofficial fan-made essay. BoJack Horseman is owned by its respective rights holders. Images are reproduced for criticism, commentary, and art-historical reference.</p>
  </footer>
</article>

<script is:inline>
  const root = document.querySelector('[data-art-essay]');
  if (root) {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const chapterNodes = [...root.querySelectorAll('[data-chapter]')];
    let frame = 0;

    const updateChapter = (chapter) => {
      const rect = chapter.getBoundingClientRect();
      const travel = Math.max(chapter.offsetHeight - window.innerHeight, 1);
      const progress = Math.min(1, Math.max(0, -rect.top / travel));
      chapter.style.setProperty('--reveal', prefersReducedMotion.matches ? '0.42' : progress.toFixed(3));
      chapter.classList.toggle('is-active', rect.top < window.innerHeight * 0.55 && rect.bottom > window.innerHeight * 0.45);
    };

    const update = () => {
      frame = 0;
      chapterNodes.forEach(updateChapter);
    };
    const requestUpdate = () => { if (!frame) frame = requestAnimationFrame(update); };
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
    prefersReducedMotion.addEventListener?.('change', requestUpdate);
    update();

    const observer = new IntersectionObserver((entries) => entries.forEach((entry) => entry.target.classList.toggle('is-visible', entry.isIntersecting)), { threshold: 0.12 });
    chapterNodes.forEach((chapter) => observer.observe(chapter));

    const modeButtons = [...root.querySelectorAll('[data-mode]')];
    const gallery = root.querySelector('[data-gallery]');
    const essayContent = root.querySelector('.essay-chapters');
    const thresholds = [...root.querySelectorAll('.essay-threshold')];
    const setMode = (mode) => {
      const isGallery = mode === 'gallery';
      const applyMode = () => {
        root.classList.toggle('is-gallery-mode', isGallery);
        gallery.hidden = !isGallery;
        essayContent.hidden = isGallery;
        thresholds.forEach((threshold) => { threshold.hidden = isGallery; });
        modeButtons.forEach((button) => {
          const selected = button.dataset.mode === mode;
          button.classList.toggle('is-selected', selected);
          button.setAttribute('aria-pressed', String(selected));
        });
      };
      if (!prefersReducedMotion.matches && document.startViewTransition) document.startViewTransition(applyMode);
      else applyMode();
    };
    modeButtons.forEach((button) => button.addEventListener('click', () => setMode(button.dataset.mode)));

    const dialogs = [...root.querySelectorAll('[data-art-dialog]')];
    root.querySelectorAll('[data-open-dialog]').forEach((button) => button.addEventListener('click', () => {
      const dialog = root.querySelector(`[data-art-dialog="${button.dataset.openDialog}"]`);
      dialog?.showModal();
    }));
    dialogs.forEach((dialog) => {
      dialog.querySelector('[data-close-dialog]')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    });

    root.querySelectorAll('[data-seam-pair]').forEach((pair) => {
      pair.addEventListener('pointermove', (event) => {
        const rect = pair.getBoundingClientRect();
        const x = Math.min(100, Math.max(0, ((event.clientX - rect.left) / rect.width) * 100));
        pair.style.setProperty('--gallery-seam', `${x.toFixed(1)}%`);
      });
      pair.addEventListener('pointerleave', () => pair.style.setProperty('--gallery-seam', '50%'));
    });
  }
</script>

<style>
  :global(html) { scroll-behavior: smooth; background: #0a0b0b; }
  .art-essay { --ink: #f1ede3; --muted: #a7aaa3; --deep: #0a0b0b; --panel: #111313; --line: rgba(241,237,227,.18); background: var(--deep); color: var(--ink); font-family: 'Avenir Next', 'Helvetica Neue', system-ui, sans-serif; line-height: 1.5; overflow: clip; }
  .art-essay a { color: inherit; }
  .essay-nav { position: absolute; inset: 0 0 auto; z-index: 5; display: flex; justify-content: space-between; align-items: center; padding: 28px clamp(20px, 4vw, 64px); font-size: .74rem; letter-spacing: .02em; }
  .essay-nav__back, .essay-nav__index { text-decoration: none; }
  .essay-nav__back:hover, .essay-nav__index:hover { color: var(--essay-accent); }
  .essay-nav__label { margin: 0; color: var(--muted); }
  .essay-nav__tools { display: flex; align-items: center; gap: 20px; }
  .essay-mode { display: inline-flex; gap: 3px; padding: 3px; border: 1px solid rgba(241,237,227,.3); border-radius: 999px; }
  .essay-mode__button { border: 0; border-radius: 999px; padding: 6px 10px; background: transparent; color: var(--muted); font: inherit; cursor: pointer; }
  .essay-mode__button:hover, .essay-mode__button:focus-visible { color: var(--ink); }
  .essay-mode__button.is-selected { background: var(--ink); color: var(--deep); }
  .essay-hero { position: relative; min-height: 100svh; display: grid; align-items: end; isolation: isolate; overflow: hidden; }
  .essay-hero__scene { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 52% 50%; z-index: -3; filter: saturate(.86) contrast(1.03); }
  .essay-hero__veil { position: absolute; inset: 0; z-index: -2; background: rgba(8,9,9,.43); }
  .essay-hero__art-plane { position: absolute; z-index: -1; top: 14vh; right: 7vw; width: clamp(170px, 24vw, 340px); aspect-ratio: 1.2; overflow: hidden; opacity: .64; mix-blend-mode: screen; }
  .essay-hero__art-plane img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.72) contrast(1.08); }
  .essay-hero__copy { width: min(760px, 78vw); padding: 0 clamp(20px, 7vw, 108px) clamp(76px, 10vh, 130px); }
  .essay-hero h1, .essay-intro h2, .essay-chapter h2, .essay-coda h2 { margin: 0; font-family: Iowan Old Style, Baskerville, Georgia, serif; font-weight: 400; letter-spacing: -.055em; line-height: .93; }
  .essay-hero h1 { font-size: clamp(4.5rem, 11vw, 11rem); }
  .essay-hero h1 em, .essay-intro h2 em, .essay-coda h2 em { color: var(--essay-accent); font-style: italic; }
  .essay-hero__thesis { max-width: 560px; margin: 34px 0 30px; font-size: clamp(1.12rem, 2vw, 1.45rem); line-height: 1.34; }
  .essay-hero__start { display: inline-flex; gap: 18px; align-items: center; padding-bottom: 5px; border-bottom: 1px solid var(--ink); text-decoration: none; font-size: .86rem; }
  .essay-hero__start:hover { color: var(--essay-accent); border-color: var(--essay-accent); }
  .essay-hero__credit { position: absolute; right: clamp(20px, 4vw, 64px); bottom: 22px; max-width: 300px; margin: 0; color: rgba(241,237,227,.62); font-size: .68rem; text-align: right; }
  .essay-intro { padding: clamp(110px, 16vw, 220px) clamp(20px, 10vw, 160px) 110px; background: var(--panel); }
  .essay-intro__grid { display: grid; grid-template-columns: 1fr minmax(260px, 420px); gap: 8vw; align-items: end; }
  .essay-intro h2 { font-size: clamp(3.7rem, 8vw, 8rem); }
  .essay-intro__grid > div { padding-bottom: .8rem; color: var(--muted); font-size: 1.08rem; }
  .essay-intro__grid p { margin: 0 0 20px; }
  .essay-intro__note { color: var(--ink); font-size: .8rem; }
  .chapter-index { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0; margin-top: 110px; border-top: 1px solid var(--line); }
  .chapter-index a { display: grid; gap: 18px; min-height: 100px; padding: 18px 12px 0 0; border-bottom: 1px solid var(--line); color: var(--muted); text-decoration: none; font-size: .8rem; }
  .chapter-index a:hover { color: var(--ink); }
  .chapter-index a span:first-child { color: var(--essay-accent); font-size: .72rem; }
  .essay-gallery { padding: clamp(120px, 16vw, 220px) clamp(20px, 5vw, 80px) 140px; background: #141614; }
  .essay-gallery__intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, 420px); gap: 8vw; align-items: end; margin: 0 auto 100px; max-width: 1320px; }
  .essay-gallery__intro h2 { margin: 0; font-family: Iowan Old Style, Baskerville, Georgia, serif; font-size: clamp(4.5rem, 10vw, 10rem); font-weight: 400; letter-spacing: -.06em; line-height: .88; }
  .essay-gallery__intro h2 em { color: var(--essay-accent); font-style: italic; }
  .essay-gallery__intro p { max-width: 360px; margin: 0 0 4px; color: var(--muted); font-size: 1.05rem; }
  .gallery-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: clamp(45px, 7vw, 120px) clamp(14px, 2.5vw, 38px); max-width: 1320px; margin: auto; }
  .gallery-item { grid-column: span 5; align-self: start; animation: gallery-rise .8s both; animation-delay: calc(var(--gallery-index, 0) * 80ms); }
  .gallery-item:nth-child(2n) { grid-column: 8 / span 5; margin-top: 100px; }
  .gallery-item:nth-child(3) { grid-column: 2 / span 6; }
  .gallery-item:nth-child(4) { grid-column: 9 / span 4; margin-top: 60px; }
  .gallery-item:nth-child(5) { grid-column: 5 / span 7; }
  .gallery-item__open { width: 100%; padding: 0; border: 0; background: none; color: var(--ink); text-align: left; cursor: pointer; }
  .gallery-item__pair { position: relative; display: block; aspect-ratio: 1.2; overflow: hidden; background: #252a27; }
  .gallery-item__scene, .gallery-item__art, .gallery-item__art-mask { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .gallery-item__scene { filter: saturate(.8); }
  .gallery-item__art-mask { clip-path: inset(0 0 0 var(--gallery-seam)); transition: clip-path .25s ease; }
  .gallery-item__art { filter: saturate(.88); }
  .gallery-item__seam { position: absolute; top: 0; bottom: 0; left: var(--gallery-seam); width: 1px; background: var(--chapter-accent); box-shadow: 0 0 0 5px rgba(10,11,11,.18); transition: left .25s ease; }
  .gallery-item__meta, .gallery-item__hint { display: flex; justify-content: space-between; gap: 10px; color: var(--muted); font-size: .7rem; letter-spacing: .06em; text-transform: uppercase; }
  .gallery-item__meta { padding-top: 9px; }
  .gallery-item__meta span:first-child { color: var(--chapter-accent); }
  .gallery-item__title { display: block; margin-top: 15px; font-family: Iowan Old Style, Baskerville, Georgia, serif; font-size: clamp(1.9rem, 3vw, 3.2rem); letter-spacing: -.04em; line-height: .96; }
  .gallery-item__hint { margin-top: 15px; color: var(--chapter-accent); opacity: 0; transform: translateY(5px); transition: opacity .25s ease, transform .25s ease; }
  .gallery-item__open:hover .gallery-item__hint, .gallery-item__open:focus-visible .gallery-item__hint { opacity: 1; transform: none; }
  .gallery-item__open:focus-visible { outline: 2px solid var(--chapter-accent); outline-offset: 10px; }
  @keyframes gallery-rise { from { opacity: 0; transform: translateY(30px) rotate(-1deg); } to { opacity: 1; transform: none; } }
  .art-dialog { width: min(1180px, calc(100% - 36px)); max-height: calc(100% - 36px); padding: 8px; border: 1px solid rgba(241,237,227,.26); background: var(--chapter-accent); color: var(--ink); }
  .art-dialog[open] { animation: dialog-frame .48s cubic-bezier(.16,1,.3,1) both; }
  .art-dialog::backdrop { background: rgba(5,6,6,.82); backdrop-filter: blur(8px); }
  .art-dialog[open]::backdrop { animation: backdrop-in .32s ease-out both; }
  .art-dialog__body { position: relative; padding: clamp(28px, 5vw, 72px); overflow: auto; background: #111313; }
  .art-dialog[open] .art-dialog__images { animation: room-unfold .65s .08s cubic-bezier(.16,1,.3,1) both; }
  .art-dialog__close { position: absolute; top: 24px; right: 24px; border: 0; background: transparent; color: var(--muted); font: inherit; cursor: pointer; }
  .art-dialog__close:hover, .art-dialog__close:focus-visible { color: var(--ink); }
  .art-dialog__heading { max-width: 650px; padding-right: 70px; }
  .art-dialog__heading > p { color: var(--muted); font-size: .75rem; letter-spacing: .04em; }
  .art-dialog__heading h2 { margin: 0 0 14px; font-family: Iowan Old Style, Baskerville, Georgia, serif; font-size: clamp(3rem, 7vw, 7rem); font-weight: 400; letter-spacing: -.04em; line-height: .9; }
  .art-dialog__heading p { margin: 0; }
  .art-dialog__images { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 70px 0 50px; }
  .art-dialog__images figure { margin: 0; }
  .art-dialog__images img { display: block; width: 100%; aspect-ratio: 1.35; object-fit: cover; }
  .art-dialog__images figcaption { padding-top: 10px; color: var(--muted); font-size: .7rem; }
  .art-dialog__copy { max-width: 670px; }
  .art-dialog__copy p { color: #cbc9c1; font-size: 1rem; }
  .art-dialog__copy .art-dialog__lede { color: var(--ink); font-family: Iowan Old Style, Baskerville, Georgia, serif; font-size: clamp(1.35rem, 2vw, 1.8rem); line-height: 1.2; }
  .art-dialog__copy blockquote { margin: 34px 0; padding-left: 18px; border-left: 1px solid var(--chapter-accent); color: var(--chapter-accent); font-family: Iowan Old Style, Baskerville, Georgia, serif; font-size: 1.5rem; }
  .art-dialog__sources { display: grid; gap: 12px; max-width: 780px; margin-top: 60px; padding-top: 24px; border-top: 1px solid var(--line); color: var(--muted); font-size: .72rem; }
  .art-dialog__sources p { margin: 0; }
  .art-dialog__sources p:first-child { color: var(--ink); text-transform: uppercase; letter-spacing: .06em; }
  .art-dialog__sources nav { display: grid; gap: 8px; margin-top: 12px; }
  .art-dialog__sources a { display: flex; justify-content: space-between; color: var(--ink); text-decoration: none; }
  .art-dialog__sources a:hover { color: var(--chapter-accent); }
  @keyframes dialog-frame { from { opacity: 0; transform: scale(.96); clip-path: inset(7% 9% round 2px); } to { opacity: 1; transform: none; clip-path: inset(0); } }
  @keyframes backdrop-in { from { opacity: 0; backdrop-filter: blur(0); } to { opacity: 1; backdrop-filter: blur(8px); } }
  @keyframes room-unfold { from { opacity: .25; clip-path: inset(0 50% 0 50%); } to { opacity: 1; clip-path: inset(0); } }
  .essay-threshold { padding: 0 clamp(20px, 10vw, 160px) 120px; background: var(--deep); }
  .essay-threshold figure { max-width: 980px; margin: 0 auto; }
  .essay-threshold img { display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .essay-threshold figcaption { display: flex; justify-content: space-between; gap: 20px; padding-top: 12px; color: var(--muted); font-size: .72rem; }
  .essay-threshold figcaption span:first-child { color: var(--essay-accent); letter-spacing: .06em; text-transform: uppercase; }
